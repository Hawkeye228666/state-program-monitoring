<Description Id="signObj">
	<Indicator id="43512" name="Количество молодых семей, улучшивших жилищные условия">
		<Units>
			<Unit value="единица"/>
		</Units>
		<Periodicities>
			<Periodicity value="Годовая - не охарактеризована" releases="1 июня" next-release="01.06.2025"/>
		</Periodicities>
		<DataRange start="2013" end="2023"/>
		<LastUpdate value="2024-06-05T12:15:40"/>
		<Dimensions>
			<Dimension value="s_OKATO" agencyID="1">
				<Name xml:lang="ru">Классификатор объектов административно-территориального деления (ОКАТО)</Name>
			</Dimension>
		</Dimensions>
		<Methodology value="Отражается количество молодых семей, улучшивших жилищные условия (в том числе с использованием ипотечных кредитов и займов) при оказании содействия за счет средств федерального бюджета, бюджетов субъектов Российской Федерации и местных бюджетов"/>
		<Organization value="Федеральная служба государственной статистики"/>
		<Department value="Управление статистики строительства, инвестиций и жилищно-коммунального хозяйства"/>
		<Allocations>
			<Allocation id="1.11.1.">
				<Name xml:lang="ru">По федеральному плану статработ / Федеральная служба государственной статистики / Жилищные условия населения, ход реформы ЖКХ / Жилищные условия населения</Name>
			</Allocation>
		</Allocations>
		<Comment value=" Статистические данные по Российской Федерации публикуются без учета статистической информации по Донецкой Народной Республике (ДНР), Луганской Народной Республике (ЛНР), Запорожской и Херсонской областям"/>
		<Responsible>
			<Name xml:lang="ru">Горнов Г.С.</Name>
			<Contacts xml:lang="ru">(495) 607-49-81, 99735 ca_GornovGS@gks.ru</Contacts>
		</Responsible>
		<Forms>
			<Form value="4-жилфонд">
				<Name xml:lang="ru">Сведения о предоставлении гражданам жилых помещений</Name>
			</Form>
		</Forms>
	</Indicator>
</Description>
