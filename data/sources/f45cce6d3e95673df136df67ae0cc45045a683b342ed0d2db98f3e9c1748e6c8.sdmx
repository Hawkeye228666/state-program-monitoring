<Description Id="signObj">
	<Indicator id="43586" name="Средний возраст исследователей по 2020 г.">
		<Units>
			<Unit value="год"/>
		</Units>
		<Periodicities>
			<Periodicity value="Годовая - не охарактеризована" releases="31 августа" next-release="31.08.2025"/>
		</Periodicities>
		<DataRange start="2010" end="2020"/>
		<LastUpdate value="2021-11-15T03:43:37"/>
		<Dimensions>
			<Dimension value="s_OKATO" agencyID="1">
				<Name xml:lang="ru">Классификатор объектов административно-территориального деления (ОКАТО)</Name>
			</Dimension>
		</Dimensions>
		<Methodology value="Показатель рассчитывается как средневзвешенная величина возраста исследователей. Рассматриваемый возраст исследователей: до 29 лет, 30-39 лет, 40-49 лет, 50-59 лет, 60-69 лет, 70 и более лет.  Показатель «Стратегии инновационного развития Российской Федерации на период до 2020 года (утверждена Распоряжением Правительства Российской Федерации от 8 декабря 2011г.   № 2227-р)»."/>
		<Organization value="Федеральная служба государственной статистики"/>
		<Department value="Управление статистики образования, науки и инноваций"/>
		<Allocations>
			<Allocation id="1.27.2.">
				<Name xml:lang="ru">По федеральному плану статработ / Федеральная служба государственной статистики / Наука и инновации / Основные показатели деятельности организаций, выполняющих научные исследования и разработки </Name>
			</Allocation>
		</Allocations>
		<Comment value=" Статистические данные по Российской Федерации публикуются без учета статистической информации по Донецкой Народной Республике (ДНР), Луганской Народной Республике (ЛНР), Запорожской и Херсонской областям"/>
		<Responsible>
			<Name xml:lang="ru">Бондаренко А.С.</Name>
			<Contacts xml:lang="ru">(495) 568-00-42, доб. 99943 bondarenkoas@rosstat.gov.ru</Contacts>
		</Responsible>
	</Indicator>
</Description>
