		</Units>
		<Periodicities>
			<Periodicity value="Квартальная - не охарактеризована" releases="на 35-й рабочий день после отчетного периода" next-release="15.02.2025"/>
		</Periodicities>
		<DataRange start="2014" end="2015"/>
		<LastUpdate value="2018-07-26T05:02:26"/>
		<Dimensions>
			<Dimension value="s_OKATO" agencyID="1">
				<Name xml:lang="ru">Классификатор объектов административно-территориального деления (ОКАТО)</Name>
