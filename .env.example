# Copy to .env and generate THREE different random secrets before first start.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_DB=monitor
POSTGRES_APP_USER=monitor_app
APP_BIND=127.0.0.1
APP_PORT=8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set both to 1 only after HTTPS is provided by the organization's ingress.
DJANGO_COOKIE_SECURE=0
DJANGO_SSL_REDIRECT=0
# Only enable when a trusted ingress overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL=0
LOG_LEVEL=INFO
